# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# The parent repo (~/solana-projects) ignores `app` (for its own Rust/Tauri
# workspace). That bare pattern also matches THIS project's app/ directory,
# which breaks git tracking AND Tailwind v4's auto-content-detection (its
# scanner skips git-ignored files), so utilities never get generated.
!/app/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
